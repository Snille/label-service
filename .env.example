# Copy to .env for docker compose. Use long random keys outside local development.
LABEL_ADMIN_KEY=
# One key per calling system: name=key, comma-separated. Names are lower-case.
LABEL_CLIENT_KEYS=storagesystem=
# Template roles: designer (create and publish templates, e.g. Label Studio), drafter (drafts only, e.g. an MCP tool).
LABEL_CLIENT_ROLES=
# Browser origins allowed to call the API directly. Empty = server-to-server only (Label Studio calls through its own server).
LABEL_ALLOWED_ORIGINS=
LABEL_PORT=3230
CUPS_QUEUE=DYMO_5XL
# The first printer: model lw5xl, lw550t, lw550, lw450 or lw4xl, and its LAN address (CUPS and the manual roll reader).
PRINTER_MODEL=lw5xl
PRINTER_NAME=
PRINTER_HOST=
PRINTER_PORT=9100
# Optional CUPS device URI instead of PRINTER_HOST, for example a USB printer passed into the cups container.
PRINTER_URI=
