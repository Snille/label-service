# Copy to .env for docker compose. Use long random keys outside local development.
LABEL_ADMIN_KEY=
# One key per calling system: name=key, comma-separated. Names are lower-case.
LABEL_CLIENT_KEYS=storagesystem=
# Browser origins allowed to call the API (for a future web designer). Empty = server-to-server only.
LABEL_ALLOWED_ORIGINS=
LABEL_PORT=3230
CUPS_QUEUE=DYMO_5XL
# The DYMO LabelWriter 5XL on the LAN. Used by CUPS and by the manual roll reader.
PRINTER_HOST=
PRINTER_PORT=9100
